OBJECT=CALLBACK_TIMER_ROUTINE
CALLBACK_TIMER_ROUTINE:TYPE=STRING

OBJECT=CALLBACK_TIMER
CALLBACK_TIMER:TYPE=TIMER
CALLBACK_TIMER:ENABLED=TRUE
CALLBACK_TIMER:ELAPSE=100
CALLBACK_TIMER:TICKS=1
CALLBACK_TIMER:ONTICK^1={ /
    CALLBACK_TIMER^RESET(); /
    CALLBACK_TIMER^ENABLE(); /
    @IF(ROUTINE_TO_CALL, "!_", NULL, "{CALLBACK_TIMER_ROUTINE^SET(ROUTINE_TO_CALL); ROUTINE_TO_CALL^SET(NULL); *CALLBACK_TIMER_ROUTINE^RUN();}", ""); /
}

OBJECT=MOUSE
MOUSE:TYPE=MOUSE

OBJECT=KEYBOARD
KEYBOARD:TYPE=KEYBOARD
KEYBOARD:ONKEYDOWN={ /
    @IF(KEYBOARD^GETLATESTKEY(), "_", "ESC", "{EPISODE^GOTO("MENU"); TEXTBOX_BREAK^RUN(); }", ""); /
}

OBJECT=PHYSICS_TICK_MS
PHYSICS_TICK_MS:TYPE=INTEGER
PHYSICS_TICK_MS:VALUE=100

OBJECT=MAIN_LOOP_TIMER
MAIN_LOOP_TIMER:TYPE=TIMER
MAIN_LOOP_TIMER:ENABLED=TRUE
MAIN_LOOP_TIMER:ELAPSE=PHYSICS_TICK_MS
MAIN_LOOP_TIMER:TICKS=1
MAIN_LOOP_TIMER:ONTICK^1={ /
    MAIN_LOOP_TIMER^RESET(); /
    MAIN_LOOP_TIMER^ENABLE(); /
    @IF(MINIGAME_ACTIVE, "_", FALSE, "{@BREAK();}", ""); /
    KROPKA_RAND_STEP^SET([0.1 * [RANDOM^GET(21) - 10]]); /
    @IF(IS_PULLING^RUN(), "_", TRUE, "{ /
        PULLING_FORCE_SUWAK^ADD(PULLING_FORCE_SUWAK_STEP^GET()); /
    }", "{ /
        PULLING_FORCE_SUWAK^SUB(PULLING_FORCE_SUWAK_STEP^GET()); /
    }"); /
    @IF(IS_KROPKA_INSIDE_SUWAK^RUN(), "_", TRUE, "{ /
        KROPKA^PLAY("ON"); /
        PULLING_FORCE_LEJEK^ADD(PULLING_FORCE_LEJEK_STEP^GET()); /
        KROPKA_RAND_STEP^MUL(2); /
        KROPKA_RAND_STEP^ADD([0.1 * IS_MORE_SPACE_ABOVE_SUWAK_THAN_BELOW^RUN()]); /
    }", "{ /
        KROPKA^PLAY("OFF"); /
        PULLING_FORCE_LEJEK^SUB(PULLING_FORCE_LEJEK_STEP^GET()); /
    }"); /
    PULLING_FORCE_KROPKA^ADD(KROPKA_RAND_STEP); /
    CALCULATE_PHYSICS_KROPKA^RUN(); /
    APPLY_PHYSICS_KROPKA^RUN(); /
    CALCULATE_PHYSICS_SUWAK^RUN(); /
    APPLY_PHYSICS_SUWAK^RUN(); /
    CALCULATE_PHYSICS_LEJEK^RUN(); /
    APPLY_PHYSICS_LEJEK^RUN(); /
    @IF(LEJEK_POSITION^GET(), ">", LEJEK_RANGE^GET(), "ON_WIN", ""); /
}

OBJECT=IS_PULLING
IS_PULLING:TYPE=BEHAVIOUR
IS_PULLING:CODE={ /
    @RETURN(TRUE); /
    @IF(MOUSE^ISLBUTTONDOWN(), "_", FALSE, "{@RETURN(FALSE);}", ""); /
    @IF(KOLOWROTEK^GETEVENTNAME(), "!_", "ONCLICK", "{@RETURN(FALSE);}", ""); /
}

OBJECT=KROPKA_RAND_STEP
KROPKA_RAND_STEP:TYPE=DOUBLE

OBJECT=CALCULATE_PHYSICS_KROPKA
CALCULATE_PHYSICS_KROPKA:TYPE=BEHAVIOUR
CALCULATE_PHYSICS_KROPKA:CODE={ /
    KROPKA_DISTANCE_DIFF_UNSCALED^SET(PHYSICS_TICK_MS); /
    KROPKA_DISTANCE_DIFF_UNSCALED^DIV(1000); /
    KROPKA_DISTANCE_DIFF_UNSCALED^POWER(2.0); /
    KROPKA_DISTANCE_DIFF_UNSCALED^MUL([0 - PULLING_FORCE_KROPKA]); /
}

OBJECT=APPLY_PHYSICS_KROPKA
APPLY_PHYSICS_KROPKA:TYPE=BEHAVIOUR
APPLY_PHYSICS_KROPKA:CODE={ /
    KROPKA_POSITION^ADD([[KROPKA_DISTANCE_DIFF_UNSCALED * KROPKA_RANGE] @ KROPKA_DISTANCE_DIFF_UNSCALED_RANGE]); /
    KROPKA_POSITION^CLAMP(0, KROPKA_RANGE^GET()); /
    @IF(KROPKA_POSITION^GET(), "_", KROPKA_RANGE^GET(), "{PULLING_FORCE_KROPKA^CLAMP(0, MAX_NUM^GET());}", ""); /
    @IF(KROPKA_POSITION^GET(), "_", 0, "{PULLING_FORCE_KROPKA^CLAMP([0 - MAX_NUM], 0);}", ""); /
    KROPKA^SETPOSITION(0, KROPKA_POSITION^ROUND()); /
}

OBJECT=CALCULATE_PHYSICS_SUWAK
CALCULATE_PHYSICS_SUWAK:TYPE=BEHAVIOUR
CALCULATE_PHYSICS_SUWAK:CODE={ /
    SUWAK_DISTANCE_DIFF_UNSCALED^SET(PHYSICS_TICK_MS); /
    SUWAK_DISTANCE_DIFF_UNSCALED^DIV(1000); /
    SUWAK_DISTANCE_DIFF_UNSCALED^POWER(2.0); /
    SUWAK_DISTANCE_DIFF_UNSCALED^MUL([0 - PULLING_FORCE_SUWAK]); /
}

OBJECT=APPLY_PHYSICS_SUWAK
APPLY_PHYSICS_SUWAK:TYPE=BEHAVIOUR
APPLY_PHYSICS_SUWAK:CODE={ /
    SUWAK_POSITION^ADD([[SUWAK_DISTANCE_DIFF_UNSCALED * SUWAK_RANGE] @ SUWAK_DISTANCE_DIFF_UNSCALED_RANGE]); /
    SUWAK_POSITION^CLAMP(0, SUWAK_RANGE^GET()); /
    KOLOWROTEK^RESUME(); /
    @IF(SUWAK_POSITION^GET(), "_", SUWAK_RANGE^GET(), "{ /
        PULLING_FORCE_SUWAK^CLAMP(0, MAX_NUM^GET()); /
        KOLOWROTEK^PAUSE(); /
    }", ""); /
    @IF(SUWAK_POSITION^GET(), "_", 0, "{ /
        PULLING_FORCE_SUWAK^CLAMP([0 - MAX_NUM], 0); /
        KOLOWROTEK^PAUSE(); /
    }", ""); /
    SUWAK^SETPOSITION(0, SUWAK_POSITION^ROUND()); /
}

OBJECT=CALCULATE_PHYSICS_LEJEK
CALCULATE_PHYSICS_LEJEK:TYPE=BEHAVIOUR
CALCULATE_PHYSICS_LEJEK:CODE={ /
    PULLING_FORCE_LEJEK^CLAMP(0, PULLING_FORCE_LEJEK_MAX^GET()); /
    LEJEK_DISTANCE_DIFF_UNSCALED^SET(PHYSICS_TICK_MS); /
    LEJEK_DISTANCE_DIFF_UNSCALED^DIV(1000); /
    LEJEK_DISTANCE_DIFF_UNSCALED^POWER(2.0); /
    LEJEK_DISTANCE_DIFF_UNSCALED^MUL([PULLING_FORCE_LEJEK - DROWNING_FORCE_LEJEK]); /
}

OBJECT=APPLY_PHYSICS_LEJEK
APPLY_PHYSICS_LEJEK:TYPE=BEHAVIOUR
APPLY_PHYSICS_LEJEK:CODE={ /
    LEJEK_POSITION^ADD([[LEJEK_DISTANCE_DIFF_UNSCALED * SUWAK_RANGE] @ LEJEK_DISTANCE_DIFF_UNSCALED_RANGE]); /
    LEJEK_POSITION^CLAMP(0, MAX_NUM^GET()); /
    LEJEK^SETPOSITION(0, [0 - LEJEK_POSITION^ROUND()]); /
}

OBJECT=MAX_NUM
MAX_NUM:TYPE=INTEGER
MAX_NUM:VALUE=99999

OBJECT=PULLING_FORCE_KROPKA
PULLING_FORCE_KROPKA:TYPE=DOUBLE
PULLING_FORCE_KROPKA:VALUE=0.0

OBJECT=PULLING_FORCE_KROPKA_STEP
PULLING_FORCE_KROPKA_STEP:TYPE=DOUBLE
PULLING_FORCE_KROPKA_STEP:VALUE=0.5

OBJECT=KROPKA_DISTANCE_DIFF_UNSCALED
KROPKA_DISTANCE_DIFF_UNSCALED:TYPE=DOUBLE
KROPKA_DISTANCE_DIFF_UNSCALED:VALUE=0.0

OBJECT=KROPKA_DISTANCE_DIFF_UNSCALED_RANGE
KROPKA_DISTANCE_DIFF_UNSCALED_RANGE:TYPE=INTEGER
KROPKA_DISTANCE_DIFF_UNSCALED_RANGE:VALUE=100

OBJECT=PULLING_FORCE_SUWAK
PULLING_FORCE_SUWAK:TYPE=DOUBLE
PULLING_FORCE_SUWAK:VALUE=0.0

OBJECT=PULLING_FORCE_SUWAK_STEP
PULLING_FORCE_SUWAK_STEP:TYPE=DOUBLE
PULLING_FORCE_SUWAK_STEP:VALUE=0.2

OBJECT=SUWAK_DISTANCE_DIFF_UNSCALED
SUWAK_DISTANCE_DIFF_UNSCALED:TYPE=DOUBLE
SUWAK_DISTANCE_DIFF_UNSCALED:VALUE=0.0

OBJECT=SUWAK_DISTANCE_DIFF_UNSCALED_RANGE
SUWAK_DISTANCE_DIFF_UNSCALED_RANGE:TYPE=INTEGER
SUWAK_DISTANCE_DIFF_UNSCALED_RANGE:VALUE=100

OBJECT=PULLING_FORCE_LEJEK
PULLING_FORCE_LEJEK:TYPE=DOUBLE
PULLING_FORCE_LEJEK:VALUE=0.0

OBJECT=PULLING_FORCE_LEJEK_STEP
PULLING_FORCE_LEJEK_STEP:TYPE=DOUBLE
PULLING_FORCE_LEJEK_STEP:VALUE=0.1

OBJECT=PULLING_FORCE_LEJEK_MAX
PULLING_FORCE_LEJEK_MAX:TYPE=DOUBLE
PULLING_FORCE_LEJEK_MAX:VALUE=25.0

OBJECT=DROWNING_FORCE_LEJEK
DROWNING_FORCE_LEJEK:TYPE=DOUBLE
DROWNING_FORCE_LEJEK:VALUE=9.8

OBJECT=LEJEK_DISTANCE_DIFF_UNSCALED
LEJEK_DISTANCE_DIFF_UNSCALED:TYPE=DOUBLE
LEJEK_DISTANCE_DIFF_UNSCALED:VALUE=0.0

OBJECT=LEJEK_DISTANCE_DIFF_UNSCALED_RANGE
LEJEK_DISTANCE_DIFF_UNSCALED_RANGE:TYPE=INTEGER
LEJEK_DISTANCE_DIFF_UNSCALED_RANGE:VALUE=100

OBJECT=MINIGAME_ACTIVE
MINIGAME_ACTIVE:TYPE=BOOL
MINIGAME_ACTIVE:VALUE=FALSE

OBJECT=LEJEK_RANGE
LEJEK_RANGE:TYPE=INTEGER
LEJEK_RANGE:VALUE=530

OBJECT=LEJEK_POSITION
LEJEK_POSITION:TYPE=DOUBLE
LEJEK_POSITION:VALUE=0

OBJECT=KROPKA_RANGE
KROPKA_RANGE:TYPE=INTEGER
KROPKA_RANGE:VALUE=285

OBJECT=KROPKA_POSITION
KROPKA_POSITION:TYPE=DOUBLE
KROPKA_POSITION:ONINIT={THIS^SET([KROPKA_RANGE @ 2]);}

OBJECT=SUWAK_HEIGHT
SUWAK_HEIGHT:TYPE=INTEGER
SUWAK_HEIGHT:VALUE=100

OBJECT=SUWAK_RANGE
SUWAK_RANGE:TYPE=INTEGER
SUWAK_RANGE:VALUE=200

OBJECT=SUWAK_POSITION
SUWAK_POSITION:TYPE=DOUBLE
SUWAK_POSITION:VALUE=0

OBJECT=IS_KROPKA_INSIDE_SUWAK
IS_KROPKA_INSIDE_SUWAK:TYPE=BEHAVIOUR
IS_KROPKA_INSIDE_SUWAK:CODE={ /
    @RETURN(TRUE); /
    @IF(SUWAK_POSITION^GET(), ">", KROPKA_POSITION^GET(), "{@RETURN(FALSE);}", ""); /
    @IF(KROPKA_POSITION^GET(), ">", [SUWAK_POSITION + SUWAK_HEIGHT], "{@RETURN(FALSE);}", ""); /
}

OBJECT=IS_MORE_SPACE_ABOVE_SUWAK_THAN_BELOW
IS_MORE_SPACE_ABOVE_SUWAK_THAN_BELOW:TYPE=BEHAVIOUR
IS_MORE_SPACE_ABOVE_SUWAK_THAN_BELOW:CODE={ /
    @RETURN(1); /
    @IF(SUWAK_POSITION^GET(), "<", [SUWAK_RANGE @ 2], "{@RETURN([0 - 1]);}", ""); /
}

OBJECT=LEJEK
LEJEK:TYPE=IMAGE
LEJEK:VISIBLE=TRUE
LEJEK:FILENAME=LEJEK.IMG
LEJEK:TOCANVAS=TRUE
LEJEK:PRIORITY=1

OBJECT=NAKLADKA
NAKLADKA:TYPE=IMAGE
NAKLADKA:VISIBLE=TRUE
NAKLADKA:FILENAME=NAKLADKA.IMG
NAKLADKA:TOCANVAS=TRUE
NAKLADKA:PRIORITY=10

OBJECT=CIEMNO
CIEMNO:TYPE=IMAGE
CIEMNO:VISIBLE=TRUE
CIEMNO:FILENAME=CIEMNO.IMG
CIEMNO:TOCANVAS=TRUE
CIEMNO:PRIORITY=20
CIEMNO:ONINIT={THIS^SETOPACITY(200);}

OBJECT=PANEL
PANEL:TYPE=IMAGE
PANEL:VISIBLE=TRUE
PANEL:FILENAME=PANEL.IMG
PANEL:TOCANVAS=TRUE
PANEL:PRIORITY=30

OBJECT=KOLOWROTEK
KOLOWROTEK:TYPE=ANIMO
KOLOWROTEK:VISIBLE=TRUE
KOLOWROTEK:FILENAME=KOLOWROTEK.ANN
KOLOWROTEK:TOCANVAS=TRUE
KOLOWROTEK:FPS=4
KOLOWROTEK:PRIORITY=31
KOLOWROTEK:ONINIT={THIS^SETASBUTTON(TRUE, TRUE);THIS^PAUSE();}
KOLOWROTEK:ONFOCUSON={THIS^PAUSE();}
KOLOWROTEK:ONFOCUSOFF={THIS^PAUSE();}
KOLOWROTEK:ONCLICK={THIS^PAUSE();}
KOLOWROTEK:ONRELEASE={THIS^PLAY("ONFOCUSON");THIS^PAUSE();}
KOLOWROTEK:ONFINISHED={THIS^PLAY(THIS^GETEVENTNAME());}

OBJECT=SUWAK
SUWAK:TYPE=IMAGE
SUWAK:VISIBLE=TRUE
SUWAK:FILENAME=SUWAK.IMG
SUWAK:TOCANVAS=TRUE
SUWAK:PRIORITY=31
SUWAK:ONINIT={THIS^SETPOSITION(0, SUWAK_POSITION^GET());}

OBJECT=KROPKA
KROPKA:TYPE=ANIMO
KROPKA:VISIBLE=TRUE
KROPKA:FILENAME=KROPKA.ANN
KROPKA:TOCANVAS=TRUE
KROPKA:PRIORITY=32
KROPKA:ONINIT={THIS^SETPOSITION(0, KROPKA_POSITION^GET());THIS^PLAY("OFF");}

OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={ /
    ARRAYPRZEDMIOTY^REMOVEALL(); /
    BEHINITSCENE^RUN("WALLEJ"); /
    BEHHIDEMENUALL^RUN(); /
    ENTERED_NON_CUTSCENE^SET(TRUE); /
    SAY^RUN("WALLEJ"); /
}

OBJECT=START_MINIGAME
START_MINIGAME:TYPE=BEHAVIOUR
START_MINIGAME:CODE={ /
    MINIGAME_ACTIVE^SET(TRUE); /
}

OBJECT=ON_WIN
ON_WIN:TYPE=BEHAVIOUR
ON_WIN:CODE={ /
    MINIGAME_ACTIVE^SET(FALSE); /
    INCREMENT_CONSTRUCTION_PHASE^RUN(); /
}

OBJECT=END_WALLEJ
END_WALLEJ:TYPE=BEHAVIOUR
END_WALLEJ:CODE={ /
    EPISODE^GOTO("STAW"); /
}
