OBJECT=KEYBOARD
KEYBOARD:TYPE=KEYBOARD
KEYBOARD:ONKEYDOWN={ /
    @IF(KEYBOARD^GETLATESTKEY(), "_", "Q", "{TEXTBOX_BREAK^RUN(); EPISODE^GOTO("MENU"); }", ""); /
}

OBJECT=IMGPODWORKO
IMGPODWORKO:TYPE=IMAGE
IMGPODWORKO:VISIBLE=TRUE
IMGPODWORKO:FILENAME=PODWORKO.IMG
IMGPODWORKO:TOCANVAS=TRUE
IMGPODWORKO:PRIORITY=999
IMGPODWORKO:PRELOAD=TRUE
IMGPODWORKO:RELEASE=TRUE
IMGPODWORKO:MONITORCOLLISION=FALSE
IMGPODWORKO:MONITORCOLLISIONALPHA=FALSE

OBJECT=BUTTONPODWORKO
BUTTONPODWORKO:TYPE=BUTTON
BUTTONPODWORKO:VISIBLE=TRUE
BUTTONPODWORKO:RECT=0,150,120,500
BUTTONPODWORKO:ENABLE=TRUE
BUTTONPODWORKO:DRAGGABLE=FALSE
BUTTONPODWORKO:GFXONMOVE=IMGPODWORKO
BUTTONPODWORKO:ONCLICKED={EPISODE^GOTO("PODWORKO");}

OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={ /
    ARRAYPRZEDMIOTY^REMOVEALL(); /
    ARRAYPRZEDMIOTY^ADD("PRALKA"); /
    ARRAYPRZEDMIOTY^ADD("KOTWICA"); /
    ARRAYPRZEDMIOTY^ADD("OPONA"); /
    ARRAYPRZEDMIOTY^ADD("PIECYK"); /
    ARRAYPRZEDMIOTY^ADD("RURASPUSTOWA"); /
    ARRAYPRZEDMIOTY^ADD("RADYJKO"); /
    ARRAYPRZEDMIOTY^ADD("SZNUR"); /
    ARRAYPRZEDMIOTY^ADD("DRABINA"); /
    BEHINITSCENE^RUN("WARSZTAT"); /
    KLAWISZE^ADD("Q"); /
    UPDATE_KLAWISZE^RUN(); /
    @IF(WARSZTAT_VISITED, "!_", TRUE, "WARSZTAT_FIRST_ENTER", ""); /
}

OBJECT=WARSZTAT_FIRST_ENTER
WARSZTAT_FIRST_ENTER:TYPE=BEHAVIOUR
WARSZTAT_FIRST_ENTER:CODE={ /
    WARSZTAT_VISITED^SET(TRUE); /
    @IF(EPISODES_UNLOCKED, "<", 2, "{EPISODES_UNLOCKED^SET(2);}", ""); /
    SAY^RUN("INTRO\WARSZTAT"); /
}
