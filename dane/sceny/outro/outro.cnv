OBJECT=KEYBOARD
KEYBOARD:TYPE=KEYBOARD
KEYBOARD:ONKEYDOWN={ /
    @IF(KEYBOARD^GETLATESTKEY(), "_", "ESC", "{TEXTBOX_BREAK^RUN(); EPISODE^GOTO("MENU"); }", ""); /
}

OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={ /
    ARRAYPRZEDMIOTY^REMOVEALL(); /
    BEHINITCUTSCENE^RUN("OUTRO"); /
    SAY^RUN("OUTRO"); /
}

OBJECT=ON_END
ON_END:TYPE=BEHAVIOUR
ON_END:CODE={ /
    APPLICATION^EXIT(); /
}
