OBJECT=KEYBOARD
KEYBOARD:TYPE=KEYBOARD
KEYBOARD:ONKEYDOWN={ /
    @IF(KEYBOARD^GETLATESTKEY(), "_", "Q", "{TEXTBOX_BREAK^RUN(); EPISODE^GOTO("MENU"); }", ""); /
}

OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={ /
    ARRAYPRZEDMIOTY^REMOVEALL(); /
    BEHINITCUTSCENE^RUN("OUTRO"); /
    KLAWISZE^ADD("Q"); /
    UPDATE_KLAWISZE^RUN(); /
    @IF(EPISODES_UNLOCKED, "<", 6, "{EPISODES_UNLOCKED^SET(6);}", ""); /
    BLOCK_TEXT_PROCEED^SET(TRUE); /
    SAY^RUN("OUTRO"); /
}

OBJECT=ON_END
ON_END:TYPE=BEHAVIOUR
ON_END:CODE={ /
    APPLICATION^EXIT(); /
}
