EPIZOD6:ONCLICK={ /
    DISABLE_BUTTONS^RUN(); /
    LAST_SCENE_NAME^SET("PODWORKO_OUTRO"); /
    EPISODE^GOTO("OUTRO"); /
}

OBJECT=SCENE_TO_LOAD
SCENE_TO_LOAD:TYPE=STRING

OBJECT=GOTO_EPISODE
GOTO_EPISODE:TYPE=BEHAVIOUR
GOTO_EPISODE:CODE={ /
    EPISODE^GOTO(SCENE_TO_LOAD); /
}

OBJECT=DISABLE_BUTTONS
DISABLE_BUTTONS:TYPE=BEHAVIOUR
DISABLE_BUTTONS:CODE={ /
    EPIZOD1^SETASBUTTON(FALSE, FALSE); /
    EPIZOD2^SETASBUTTON(FALSE, FALSE); /
    EPIZOD3^SETASBUTTON(FALSE, FALSE); /
    EPIZOD4^SETASBUTTON(FALSE, FALSE); /
    EPIZOD5^SETASBUTTON(FALSE, FALSE); /
    EPIZOD6^SETASBUTTON(FALSE, FALSE); /
}

OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={ /
    BEHINITCUTSCENE^RUN("EPIZODY"); /
}

