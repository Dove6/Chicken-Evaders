EPIZOD5:ONCLICK={ /
    DISABLE_BUTTONS^RUN(); /
    BEHRESETROZDZIAL^RUN(); /
    CONSTRUCTION_PHASE^SET(14); /
    RADIATOR_DONE^SET(FALSE); /
    WARSZTAT_VISITED^SET(TRUE); /
    PODWORKO_VISITED^SET(TRUE); /
    KURNIKI_VISITED^SET(TRUE); /
    LETTER^SET(""); /
    ANGLE^SET(""); /
    KIESZEN^REMOVEALL(); /
    KIESZEN^SAVEINI(); /
    ZBUDOWANE^REMOVEALL(); /
    KIESZEN^SAVEINI(); /
    ZBUDOWANE^REMOVEALL(); /
    ZBUDOWANE^ADD("KOLOWROTEK", "ANTENA", "LEJEK", "RADYJKO", "BUTELKA2", "BUTELKA1", "BUTELKA3", "PULPIT", "SZPULA", "SZNUR"); /
    ZBUDOWANE^SAVEINI(); /
    SCENE_TO_LOAD^SET("PISANIE"); /
    SAY^RUN("EPIZODY\WYWIAD5"); /
}

OBJECT=EPIZOD6
EPIZOD6:TYPE=ANIMO
EPIZOD6:VISIBLE=FALSE
EPIZOD6:FILENAME=EPIZOD6.ANN
