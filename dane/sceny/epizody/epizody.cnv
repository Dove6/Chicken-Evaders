}

OBJECT=EPIZOD3
EPIZOD3:TYPE=ANIMO
EPIZOD3:VISIBLE=FALSE
EPIZOD3:FILENAME=EPIZOD3.ANN
EPIZOD3:TOCANVAS=TRUE
EPIZOD3:PRIORITY=20
EPIZOD3:ONFOCUSON={;}
EPIZOD3:ONINIT={THIS^SETASBUTTON(TRUE, TRUE);}
EPIZOD3:ONCLICK={ /
    DISABLE_BUTTONS^RUN(); /
    BEHRESETROZDZIAL^RUN(); /
    CONSTRUCTION_PHASE^SET(6); /
    RADIATOR_DONE^SET(FALSE); /
    WARSZTAT_VISITED^SET(TRUE); /
    PODWORKO_VISITED^SET(TRUE); /
    KURNIKI_VISITED^SET(TRUE); /
    LETTER^SET(""); /
    ANGLE^SET(""); /
    KIESZEN^REMOVEALL(); /
    KIESZEN^SAVEINI(); /
    ZBUDOWANE^REMOVEALL(); /
    ZBUDOWANE^ADD("KOLOWROTEK", "ANTENA"); /
    ZBUDOWANE^SAVEINI(); /
    SCENE_TO_LOAD^SET("WALLEJ"); /
    SAY^RUN("EPIZODY\WYWIAD3"); /
}

OBJECT=EPIZOD4
EPIZOD4:TYPE=ANIMO
EPIZOD4:VISIBLE=FALSE
EPIZOD4:FILENAME=EPIZOD4.ANN
EPIZOD4:TOCANVAS=TRUE
EPIZOD4:PRIORITY=20
EPIZOD4:ONFOCUSON={;}
EPIZOD4:ONINIT={THIS^SETASBUTTON(TRUE, TRUE);}
EPIZOD4:ONCLICK={ /
    DISABLE_BUTTONS^RUN(); /
    BEHRESETROZDZIAL^RUN(); /
    CONSTRUCTION_PHASE^SET(10); /
    RADIATOR_DONE^SET(FALSE); /
    WARSZTAT_VISITED^SET(TRUE); /
    PODWORKO_VISITED^SET(TRUE); /
    KURNIKI_VISITED^SET(TRUE); /
    LETTER^SET(""); /
    ANGLE^SET(""); /
    KIESZEN^REMOVEALL(); /
    KIESZEN^SAVEINI(); /
    ZBUDOWANE^REMOVEALL(); /
    ZBUDOWANE^ADD("KOLOWROTEK", "ANTENA", "LEJEK", "RADYJKO", "BUTELKA2", "BUTELKA1", "BUTELKA3"); /
    ZBUDOWANE^SAVEINI(); /
    SCENE_TO_LOAD^SET("SIGMALIS"); /
    SAY^RUN("EPIZODY\WYWIAD4"); /
}

OBJECT=EPIZOD5
EPIZOD5:TYPE=ANIMO
EPIZOD5:VISIBLE=FALSE
EPIZOD5:FILENAME=EPIZOD5.ANN
EPIZOD5:TOCANVAS=TRUE
EPIZOD5:PRIORITY=20
