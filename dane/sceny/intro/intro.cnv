OBJECT=KEYBOARD
KEYBOARD:TYPE=KEYBOARD
KEYBOARD:ONKEYDOWN={ /
    @IF(KEYBOARD^GETLATESTKEY(), "_", "Q", "{TEXTBOX_BREAK^RUN(); EPISODE^GOTO("MENU"); }", ""); /
}

OBJECT=GETBASESCALE
GETBASESCALE:TYPE=BEHAVIOUR
GETBASESCALE:CODE={ /
    @RETURN(1.0); /
    @IF($1, "_", "KADR1" , "{@RETURN(1.064);}", ""); /
    @IF($1, "_", "KADR2" , "{@RETURN(0.834);}", ""); /
    @IF($1, "_", "KADR3" , "{@RETURN(1);}", ""); /
    @IF($1, "_", "KADR4" , "{@RETURN(0.75);}", ""); /
    @IF($1, "_", "CIEMNO1" , "{@RETURN(1);}", ""); /
    @IF($1, "_", "KADR5" , "{@RETURN(0.6826);}", ""); /
    @IF($1, "_", "KADR6" , "{@RETURN(0.834);}", ""); /
    @IF($1, "_", "KADR7" , "{@RETURN(1.331);}", ""); /
    @IF($1, "_", "KADR8" , "{@RETURN(1);}", ""); /
    @IF($1, "_", "KADR9" , "{@RETURN(1);}", ""); /
    @IF($1, "_", "CIEMNO2" , "{@RETURN(1.5);}", ""); /
    @IF($1, "_", "KADR10" , "{@RETURN(0.667);}", ""); /
    @IF($1, "_", "CIEMNO3" , "{@RETURN(1);}", ""); /
}

OBJECT=GETZOOMSCALE
GETZOOMSCALE:TYPE=BEHAVIOUR
GETZOOMSCALE:CODE={ /
    @RETURN(1.0); /
    @IF($1, "_", "KADR1" , "{@RETURN(1.5);}", ""); /
    @IF($1, "_", "KADR2" , "{@RETURN(1.4);}", ""); /
    @IF($1, "_", "KADR3" , "{@RETURN(1.6);}", ""); /
    @IF($1, "_", "KADR4" , "{@RETURN(2.28);}", ""); /
    @IF($1, "_", "KADR10" , "{@RETURN(1.5);}", ""); /
}

OBJECT=FSCALE
FSCALE:TYPE=STATICFILTER
FSCALE:ACTION=SCALE

OBJECT=SETSCALELERP_SCALE
SETSCALELERP_SCALE:TYPE=DOUBLE

OBJECT=SETSCALELERP_DIVIDEND
SETSCALELERP_DIVIDEND:TYPE=DOUBLE

OBJECT=SETSCALELERP_DIVISOR
SETSCALELERP_DIVISOR:TYPE=DOUBLE

OBJECT=SETSCALELERP_BASE
SETSCALELERP_BASE:TYPE=DOUBLE

OBJECT=SETSCALELERP_ZOOM
SETSCALELERP_ZOOM:TYPE=DOUBLE

OBJECT=SETSCALELERP_POSX
SETSCALELERP_POSX:TYPE=DOUBLE

OBJECT=SETSCALELERP_POSY
SETSCALELERP_POSY:TYPE=DOUBLE

# $1 - base scale
# $2 - initial zoom
# $3 - horizontal anchor [0; 1]
# $4 - vertical anchor [0; 1]
OBJECT=SETSCALELERP
SETSCALELERP:TYPE=BEHAVIOUR
SETSCALELERP:CODE={ /
    SETSCALELERP_DIVIDEND^SET(INTRO_CINEMATIC^GETCFRAMEINEVENT()); /
    SETSCALELERP_DIVISOR^SET([INTRO_CINEMATIC^GETNOFINEVENT(INTRO_CINEMATIC^GETEVENTNAME()) - 1]); /
    @IF(SETSCALELERP_DIVISOR, "<", 1, "{SETSCALELERP_DIVIDEND^SET(1.0); SETSCALELERP_DIVISOR^SET(1.0);}", ""); /
    SETSCALELERP_SCALE^SET($2); /
    SETSCALELERP_SCALE^SUB(1); /
    SETSCALELERP_SCALE^MUL([1.0 - [SETSCALELERP_DIVIDEND @ SETSCALELERP_DIVISOR]]); /
    SETSCALELERP_SCALE^ADD(1); /
    SETSCALELERP_SCALE^MUL($1); /
    FSCALE^UNLINK("INTRO_CINEMATIC"); /
    SETSCALELERP_POSX^SET(INTRO_CINEMATIC^GETWIDTH()); /
    SETSCALELERP_POSY^SET(INTRO_CINEMATIC^GETHEIGHT()); /
    FSCALE^SETPROPERTY("FACTORX", SETSCALELERP_SCALE^GET()); /
    FSCALE^SETPROPERTY("FACTORY", SETSCALELERP_SCALE^GET()); /
    FSCALE^LINK("INTRO_CINEMATIC"); /
    SETSCALELERP_POSX^MUL([$1 - SETSCALELERP_SCALE]); /
    SETSCALELERP_POSY^MUL([$1 - SETSCALELERP_SCALE]); /
    SETSCALELERP_POSX^MUL($3); /
    SETSCALELERP_POSY^MUL($4); /
    INTRO_CINEMATIC^SETPOSITION(SETSCALELERP_POSX^GET(), SETSCALELERP_POSY^GET()); /
}

OBJECT=INTRO_CINEMATIC
INTRO_CINEMATIC:TYPE=ANIMO
INTRO_CINEMATIC:VISIBLE=TRUE
INTRO_CINEMATIC:TOCANVAS=TRUE
INTRO_CINEMATIC:PRIORITY=100
INTRO_CINEMATIC:FILENAME=CINEMATIC.ANN
INTRO_CINEMATIC:ONINIT={ /
    FSCALE^SETPROPERTY("CANUNDO", TRUE); /
    FSCALE^SETPROPERTY("FACTORX", 1.0); /
    FSCALE^SETPROPERTY("FACTORYZ", 1.0); /
    FSCALE^LINK("INTRO_CINEMATIC"); /
}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR1=SETSCALELERP(1.064, 1.5, 0.0, 1.0)
INTRO_CINEMATIC:ONFINISHED^KADR1={THIS^PLAY("KADR2");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR2=SETSCALELERP(0.834, 1.4, 1.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^KADR2={THIS^PLAY("KADR3");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR3=SETSCALELERP(1.0, 1.6, 0.58, 0.22)
INTRO_CINEMATIC:ONFINISHED^KADR3={THIS^PLAY("KADR4");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR4=SETSCALELERP(0.75, 2.28, 0.68, 0.33)
INTRO_CINEMATIC:ONFINISHED^KADR4={THIS^PLAY("CIEMNO1");}
INTRO_CINEMATIC:ONFRAMECHANGED^CIEMNO1=SETSCALELERP(1.0, 1.0, 0.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^CIEMNO1={THIS^PLAY("KADR5");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR5=SETSCALELERP(1.0, 1.0, 0.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^KADR5={THIS^PLAY("KADR6");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR6=SETSCALELERP(1.0, 1.0, 0.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^KADR6={THIS^PLAY("KADR7");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR7=SETSCALELERP(1.0, 1.0, 0.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^KADR7={THIS^PLAY("KADR8");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR8=SETSCALELERP(1.0, 1.0, 0.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^KADR8={THIS^PLAY("KADR9");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR9=SETSCALELERP(1.0, 1.0, 0.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^KADR9={THIS^PLAY("CIEMNO2");}
INTRO_CINEMATIC:ONFRAMECHANGED^CIEMNO2=SETSCALELERP(1.5, 1.0, 0.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^CIEMNO2={THIS^PLAY("KADR10");}
INTRO_CINEMATIC:ONFRAMECHANGED^KADR10=SETSCALELERP(0.667, 1.5, 0.05, 0.5)
INTRO_CINEMATIC:ONFINISHED^KADR10={THIS^PLAY("CIEMNO3");}
INTRO_CINEMATIC:ONFRAMECHANGED^CIEMNO3=SETSCALELERP(1.0, 1.0, 0.0, 0.0)
INTRO_CINEMATIC:ONFINISHED^CIEMNO3={@IF(INTRO_SOUND^ISPLAYING(), "_", FALSE, "ON_INTRO_END", "");}
INTRO_CINEMATIC:ONCLICK=ON_INTRO_END

OBJECT=INTRO_SOUND
INTRO_SOUND:TYPE=SOUND
INTRO_SOUND:FILENAME=..\INTRO.WAV
INTRO_SOUND:ONFINISHED={@IF(INTRO_CINEMATIC^ISPLAYING(), "_", FALSE, "ON_INTRO_END", "");}

OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={ /
    ARRAYPRZEDMIOTY^REMOVEALL(); /
    BEHINITCUTSCENE^RUN("INTRO"); /
    KLAWISZE^ADD("Q"); /
    UPDATE_KLAWISZE^RUN(); /
    INTRO_CINEMATIC^PLAY("KADR1"); /
    INTRO_SOUND^PLAY(); /
    INTRO_CINEMATIC^SETASBUTTON(TRUE, TRUE); /
}

OBJECT=ON_INTRO_END
ON_INTRO_END:TYPE=BEHAVIOUR
ON_INTRO_END:CODE={ /
    EPISODE^GOTO("WARSZTAT"); /
}
