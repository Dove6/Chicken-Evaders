OBJECT=CALLBACK_TIMER_ROUTINE
CALLBACK_TIMER_ROUTINE:TYPE=STRING

OBJECT=CALLBACK_TIMER
CALLBACK_TIMER:TYPE=TIMER
CALLBACK_TIMER:ENABLED=TRUE
CALLBACK_TIMER:ELAPSE=100
CALLBACK_TIMER:TICKS=1
CALLBACK_TIMER:ONTICK^1={ /
    CALLBACK_TIMER^RESET(); /
    CALLBACK_TIMER^ENABLE(); /
    @IF(ROUTINE_TO_CALL, "!_", NULL, "{CALLBACK_TIMER_ROUTINE^SET(ROUTINE_TO_CALL); ROUTINE_TO_CALL^SET(NULL); *CALLBACK_TIMER_ROUTINE^RUN();}", ""); /
}

OBJECT=IKONA_GRA
IKONA_GRA:TYPE=ANIMO
IKONA_GRA:VISIBLE=FALSE
IKONA_GRA:FILENAME=IKONA_GRA.ANN
IKONA_GRA:TOCANVAS=TRUE
IKONA_GRA:PRIORITY=20
IKONA_GRA:ONFOCUSON={;}
IKONA_GRA:ONINIT={THIS^SETOPACITY(0);}
IKONA_GRA:ONCLICK=CONTINUE_GAME

OBJECT=IKONA_DRZWI
IKONA_DRZWI:TYPE=ANIMO
IKONA_DRZWI:VISIBLE=FALSE
IKONA_DRZWI:FILENAME=IKONA_DRZWI.ANN
IKONA_DRZWI:TOCANVAS=TRUE
IKONA_DRZWI:PRIORITY=20
IKONA_DRZWI:ONFOCUSON={;}
IKONA_DRZWI:ONINIT={THIS^SETOPACITY(0);}
IKONA_DRZWI:ONCLICK=EXIT_GAME

OBJECT=IKONA_ZAPIS
IKONA_ZAPIS:TYPE=ANIMO
IKONA_ZAPIS:VISIBLE=FALSE
IKONA_ZAPIS:FILENAME=IKONA_ZAPIS.ANN
IKONA_ZAPIS:TOCANVAS=TRUE
IKONA_ZAPIS:PRIORITY=20
IKONA_ZAPIS:ONFOCUSON={;}
IKONA_ZAPIS:ONINIT={THIS^SETOPACITY(0);}
IKONA_ZAPIS:ONCLICK={;}

OBJECT=TITLE
TITLE:TYPE=IMAGE
TITLE:VISIBLE=TRUE
TITLE:FILENAME=TITLE.IMG
TITLE:TOCANVAS=TRUE
TITLE:PRIORITY=50
TITLE:ONINIT={THIS^SETOPACITY(0);}

OBJECT=BKG_START
BKG_START:TYPE=IMAGE
BKG_START:VISIBLE=TRUE
BKG_START:FILENAME=BKG_START.IMG
BKG_START:TOCANVAS=TRUE
BKG_START:PRIORITY=10

OBJECT=BKG_FLICKER
BKG_FLICKER:TYPE=IMAGE
BKG_FLICKER:VISIBLE=FALSE
BKG_FLICKER:FILENAME=BKG_FLICKER.IMG
BKG_FLICKER:TOCANVAS=TRUE
BKG_FLICKER:PRIORITY=11

OBJECT=BKG_CAUGHT
BKG_CAUGHT:TYPE=IMAGE
BKG_CAUGHT:VISIBLE=FALSE
BKG_CAUGHT:FILENAME=BKG_CAUGHT.IMG
BKG_CAUGHT:TOCANVAS=TRUE
BKG_CAUGHT:PRIORITY=12

OBJECT=BKG_FLED
BKG_FLED:TYPE=IMAGE
BKG_FLED:VISIBLE=FALSE
BKG_FLED:FILENAME=BKG_FLED.IMG
BKG_FLED:TOCANVAS=TRUE
BKG_FLED:PRIORITY=13

OBJECT=UFO
UFO:TYPE=IMAGE
UFO:VISIBLE=FALSE
UFO:FILENAME=UFO.IMG
UFO:TOCANVAS=TRUE
UFO:PRIORITY=14

OBJECT=NAKLADKA_FLED
NAKLADKA_FLED:TYPE=IMAGE
NAKLADKA_FLED:VISIBLE=FALSE
NAKLADKA_FLED:FILENAME=NAKLADKA_FLED.IMG
NAKLADKA_FLED:TOCANVAS=TRUE
NAKLADKA_FLED:PRIORITY=15

OBJECT=BKG_DIM
BKG_DIM:TYPE=IMAGE
BKG_DIM:VISIBLE=FALSE
BKG_DIM:FILENAME=BKG_DIM.IMG
BKG_DIM:TOCANVAS=TRUE
BKG_DIM:PRIORITY=800
BKG_DIM:ONINIT={THIS^SETOPACITY(0);}

OBJECT=PHASE1_EASEOUT_SECONDS
PHASE1_EASEOUT_SECONDS:TYPE=DOUBLE

OBJECT=PHASE1_EASEOUT
PHASE1_EASEOUT:TYPE=TIMER
PHASE1_EASEOUT:ENABLED=FALSE
PHASE1_EASEOUT:ELAPSE=10
PHASE1_EASEOUT:TICKS=100
PHASE1_EASEOUT:ONTICK=PHASE1_EASEOUT_ONTICK
PHASE1_EASEOUT:ONTICK^50={ /
    PHASE1_EASEOUT_ONTICK^RUN(); /
    IKONA_GRA^SHOW(); /
    IKONA_GRA^SETASBUTTON(TRUE, TRUE); /
    IKONA_GRA^SETOPACITY(0); /
    IKONA_DRZWI^SHOW(); /
    IKONA_DRZWI^SETASBUTTON(TRUE, TRUE); /
    IKONA_DRZWI^SETOPACITY(0); /
    !IKONA_ZAPIS^SHOW(); /
    !IKONA_ZAPIS^SETASBUTTON(TRUE, TRUE); /
    !IKONA_ZAPIS^SETOPACITY(0); /
    PHASE2_UI^ENABLE(); /
}

OBJECT=PHASE1_EASEOUT_ONTICK
PHASE1_EASEOUT_ONTICK:TYPE=BEHAVIOUR
PHASE1_EASEOUT_ONTICK:CODE={ /
    PHASE1_EASEOUT_SECONDS^SET(PHASE1_EASEOUT^GETTICKS()); /
    PHASE1_EASEOUT_SECONDS^DIV(100); /
    BKG_START^SETPOSITION(0, [PHASE1_EASEOUT_SECONDS * 60]); /
}

OBJECT=PHASE2_UI_SECONDS
PHASE2_UI_SECONDS:TYPE=DOUBLE

OBJECT=PHASE2_UI
PHASE2_UI:TYPE=TIMER
PHASE2_UI:ENABLED=FALSE
PHASE2_UI:ELAPSE=10
PHASE2_UI:TICKS=100
PHASE2_UI:ONTICK={ /
    PHASE2_UI_SECONDS^SET(PHASE2_UI^GETTICKS()); /
    PHASE2_UI_SECONDS^DIV(100); /
    TITLE^SETOPACITY([PHASE2_UI_SECONDS * 255]); /
    IKONA_GRA^SETOPACITY([PHASE2_UI_SECONDS * 255]); /
    IKONA_DRZWI^SETOPACITY([PHASE2_UI_SECONDS * 255]); /
    !IKONA_ZAPIS^SETOPACITY([PHASE2_UI_SECONDS * 255]); /
}

OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
__INIT__:CODE={ /
    BEHINITCUTSCENE^RUN("MENU"); /
    PHASE1_EASEOUT^ENABLE(); /
}

OBJECT=START_NEW_GAME
START_NEW_GAME:TYPE=BEHAVIOUR
START_NEW_GAME:CODE={ /
    BEHRESETROZDZIAL^RUN(); /
    GOTO_SCENE^RUN("INTRO"); /
}

OBJECT=CONTINUE_GAME
CONTINUE_GAME:TYPE=BEHAVIOUR
CONTINUE_GAME:CODE={ /
    @IF(LAST_SCENE_NAME, "_", "", "{START_NEW_GAME^RUN(); @BREAK();}", ""); /
    GOTO_SCENE^RUN(LAST_SCENE_NAME); /
}

# $1 - nazwa sceny
OBJECT=GOTO_SCENE
GOTO_SCENE:TYPE=BEHAVIOUR
GOTO_SCENE:CODE={ /
    IKONA_GRA^SETASBUTTON(FALSE, FALSE); /
    IKONA_DRZWI^SETASBUTTON(FALSE, FALSE); /
    !IKONA_ZAPIS^SETASBUTTON(FALSE, FALSE); /
    SCENE_TO_LOAD^SET($1); /
    PHASE3_FLICKER^ENABLE(); /
}

OBJECT=SCENE_TO_LOAD
SCENE_TO_LOAD:TYPE=STRING

OBJECT=EXIT_GAME
EXIT_GAME:TYPE=BEHAVIOUR
EXIT_GAME:CODE={ /
    APPLICATION^EXIT(); /
}

OBJECT=PHASE3_FLICKER_VALUE
PHASE3_FLICKER_VALUE:TYPE=BOOL

OBJECT=PHASE3_FLICKER
PHASE3_FLICKER:TYPE=TIMER
PHASE3_FLICKER:ENABLED=FALSE
PHASE3_FLICKER:ELAPSE=50
PHASE3_FLICKER:TICKS=10
PHASE3_FLICKER:ONTICK={ /
    PHASE3_FLICKER_VALUE^SWITCH(TRUE, FALSE); /
    @IF(PHASE3_FLICKER^GETTICKS(), ">", 6, "{BKG_CAUGHT^SHOW();@BREAK();}", ""); /
    @IF(PHASE3_FLICKER_VALUE^GET(), "_", TRUE, "{BKG_FLICKER^SHOW();}", "{BKG_FLICKER^HIDE();}"); /
}
PHASE3_FLICKER:ONTICK^10={ /
    PHASE4_FLEE^ENABLE(); /
}

OBJECT=PHASE4_FLEE
PHASE4_FLEE:TYPE=TIMER
PHASE4_FLEE:ENABLED=FALSE
PHASE4_FLEE:ELAPSE=10
PHASE4_FLEE:TICKS=71
PHASE4_FLEE:ONTICK^1={ /
    BKG_FLED^SHOW(); /
    UFO^SHOW(); /
    NAKLADKA_FLED^SHOW(); /
}
PHASE4_FLEE:ONTICK={ /
    UFO^MOVE(1, -2); /
}
PHASE4_FLEE:ONTICK^40={ /
    PHASE5_DIM^ENABLE(); /
}

OBJECT=PHASE5_DIM_SECONDS
PHASE5_DIM_SECONDS:TYPE=DOUBLE

OBJECT=PHASE5_DIM
PHASE5_DIM:TYPE=TIMER
PHASE5_DIM:ENABLED=FALSE
PHASE5_DIM:ELAPSE=10
PHASE5_DIM:TICKS=101
PHASE5_DIM:ONTICK^1={ /
    BKG_DIM^SHOW(); /
    BKG_DIM^SETOPACITY(0); /
}
PHASE5_DIM:ONTICK={ /
    PHASE5_DIM_SECONDS^SET(PHASE5_DIM^GETTICKS()); /
    PHASE5_DIM_SECONDS^DIV(100); /
    BKG_DIM^SETOPACITY([PHASE5_DIM_SECONDS * 255]); /
}
PHASE5_DIM:ONTICK^101={ /
    EPISODE^GOTO(SCENE_TO_LOAD); /
}

OBJECT=PARAMETRIC_BLEND_ALPHA
PARAMETRIC_BLEND_ALPHA:TYPE=DOUBLE
PARAMETRIC_BLEND_ALPHA:VALUE=2.0

OBJECT=PARAMETRIC_BLEND
PARAMETRIC_BLEND:TYPE=BEHAVIOUR
PARAMETRIC_BLEND:CODE={ /
    PARAMETRIC_BLEND_SQUARED^SET($1); /
    PARAMETRIC_BLEND_SQUARED^POWER(2); /
    PARAMETRIC_BLEND_RESULT^SET([PARAMETRIC_BLEND_SQUARED - $1]); /
    PARAMETRIC_BLEND_RESULT^MUL(PARAMETRIC_BLEND_ALPHA^GET()); /
    PARAMETRIC_BLEND_RESULT^ADD(1); /
    @RETURN([PARAMETRIC_BLEND_SQUARED @ PARAMETRIC_BLEND_RESULT]); /
}

OBJECT=PARAMETRIC_BLEND_SQUARED
PARAMETRIC_BLEND_SQUARED:TYPE=DOUBLE

OBJECT=PARAMETRIC_BLEND_RESULT
PARAMETRIC_BLEND_RESULT:TYPE=DOUBLE
